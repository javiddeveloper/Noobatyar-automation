{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "front_client",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "front_client", "run", "dev"],
      "port": 3000
    },
    {
      "name": "backend",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd backend && source .venv/bin/activate && python manage.py runserver 0.0.0.0:8000"],
      "port": 8000
    }
  ]
}
