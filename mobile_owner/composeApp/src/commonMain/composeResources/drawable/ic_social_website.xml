<!--
    Website — white globe outline, authored here rather than reusing
    Icons.Rounded.Language so its stroke weight matches the other four glyphs in
    the contact list (Material's icon is a filled glyph and reads visibly heavier).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- outer sphere -->
    <path
        android:pathData="M12,3.1 A8.9,8.9 0 1 1 11.99,3.1 Z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.9" />
    <!-- equator -->
    <path
        android:pathData="M3.1,12 L20.9,12"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.9"
        android:strokeLineCap="round" />
    <!-- meridian -->
    <path
        android:pathData="M12,3.1 C15.1,6.1 15.1,17.9 12,20.9 C8.9,17.9 8.9,6.1 12,3.1 Z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.9"
        android:strokeLineJoin="round" />
</vector>
