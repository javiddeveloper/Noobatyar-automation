<!--
    Instagram — white camera outline for the official-gradient tile.

    Replaces instagram.xml, which was a flat single-colour (#E1306C) fill. The
    brand mark's defining feature is its gradient, so the colour now lives on the
    tile (Brush in AboutUsScreen) and the glyph is a clean stroked outline.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- camera body -->
    <path
        android:pathData="M8,3.2 L16,3.2 A4.8,4.8 0 0 1 20.8,8 L20.8,16 A4.8,4.8 0 0 1 16,20.8 L8,20.8 A4.8,4.8 0 0 1 3.2,16 L3.2,8 A4.8,4.8 0 0 1 8,3.2 Z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.9"
        android:strokeLineJoin="round" />
    <!-- lens -->
    <path
        android:pathData="M12,8.2 A3.8,3.8 0 1 1 11.99,8.2 Z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.9" />
    <!-- flash dot -->
    <path
        android:pathData="M16.9,6.1 m-1.15,0 a1.15,1.15 0 1,0 2.3,0 a1.15,1.15 0 1,0 -2.3,0 Z"
        android:fillColor="#FFFFFF" />
</vector>
