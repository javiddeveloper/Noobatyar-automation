<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>نوبت یار</string>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Production is HTTPS (api.noobatyar.ir), so App Transport Security stays
	     on. NSAllowsArbitraryLoads is gone; only local networking is exempt, so
	     a developer can still point the app at a dev server on their machine. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>xyz.sattar.javid.proqueue</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>noobatyar</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
