# Template for backend/.env.local (local dev only — see docs/ENVIRONMENTS.md).
# Copy this file to backend/.env.local and adjust. .env.local is gitignored;
# this .env.example file is the only variant meant to be committed.
#
# Production does NOT use this file — it gets its env vars from the
# repo-root .env consumed by docker-compose (POSTGRES_*, SECRET_KEY,
# CORS_ALLOWED_ORIGINS, ZIBAL_MERCHANT_ID, CLIENT_WEB_URL, etc., all pointing
# at real infra). See DEPLOY_UPDATE_BACKEND.md / DEPLOY_TLS_DOMAIN.md for that side.

DEBUG=True
ALLOWED_HOSTS=127.0.0.1,10.0.2.2,localhost

# Zibal sandbox merchant — always succeeds, moves no real money.
ZIBAL_MERCHANT_ID=zibal

# Must be reachable from the payer's browser. Pick based on what you're testing:
#   Android emulator -> http://10.0.2.2:3000
#   iOS Simulator     -> http://127.0.0.1:3000
CLIENT_WEB_URL=http://10.0.2.2:3000

SITE_URL=http://127.0.0.1:8000

# Dev-only, both require DEBUG=True (forced off otherwise in settings.py):
OTP_DEV_CODE=123456
SMS_DEV_MODE=True
