mobile_owner/.gradle/buildOutputCleanup/cache.properties
mobile_owner/.gradle/vcs-1/gc.properties
mobile_owner/build/reports/problems/problems-report.html
deploy_bundle.zip

# Secrets. This repo already leaked a server password through committed
# helper scripts — env files carry the payment merchant id and SMS tokens,
# so keep them out of history entirely.
.env
.env.*
!.env.example

# Deploy artefacts built from the working tree.
backend_update.zip
frontend_update.zip

# Ad-hoc expect scripts. These embed the server password in plaintext, and the
# three narrow patterns that used to live here let 17 of them slip in anyway
# (add_swap.exp, deploy_ssh.exp, update_backend.exp, …). Ignore the extension
# outright. NOTE: .gitignore does not untrack what is already committed — the
# ones in history still need `git rm --cached` plus a history rewrite.
*.exp

# Python local dev
.venv/
__pycache__/
*.pyc

# Local dev database. Was tracked, so every local test run (a booking, a new
# user) showed up as a binary diff. Production uses Postgres via POSTGRES_DB.
backend/db.sqlite3
backend/db.sqlite3.bak-*

# User uploads (logos, payment receipts). These are runtime data that belongs on
# the server, not in history — a client's payment slip especially. The two files
# already committed stay tracked on purpose; a deploy from the repo still needs
# the business logo.
backend/media/
.DS_Store
*.tar.gz
